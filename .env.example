# Copy to `.env` and fill in. Never commit `.env`.
# Used by Main-process Gemini Multimodal Live (Phase 4–5).
GEMINI_API_KEY=

# Optional override if Google renames the preview model id.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Force MockGeminiLiveClient (no network) even when a key is present.
# Useful for CI / headless demos without hitting the Live API.
# ONEBROWZER_VOICE_MOCK=1

# Phase 5 notes (no new required env vars):
# - Browser tools (get_ax_tree, highlight_node, navigate, list_tabs) bind on
#   voice:start for the Active Worker tab only.
# - Session transcripts persist under Electron userData via sql.js SQLite
#   (JSON file fallback if WASM init fails). No DB URL env needed.
